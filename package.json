{
  "name": "streamcrowd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:analyze": "vite build && start dist/bundle-report.html",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:check-cycles": "eslint . --ext .ts,.tsx --rule 'import/no-cycle: error'",
    "test": "vitest",
    "test:watch": "vitest",
    "test:firebase-rules": "vitest --run tests/firebase-rules/firebase-rules.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test -- --run && npm run test:e2e",
    "bundle:analyze": "npm run build && node scripts/bundle-size-check.js",
    "bundle:check": "node scripts/bundle-size-check.js",
    "bundle:report": "npm run build && node scripts/bundle-size-check.js && start bundle-size-report.md",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "prepare": "husky install",
    "validate": "npm run lint && npm run test -- --run && npx tsc --noEmit",
    "ci": "npm run validate && npm run test:e2e",
    "i18n:validate": "node i18n/validate-cli.cjs --verbose"
  },
  "description": "Suite de herramientas interactivas para streamers - Encuestas, sorteos, juegos y más",
  "author": "StreamCrowd Team",
  "build": {
    "appId": "com.streamcrowd.app",
    "productName": "StreamCrowd",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/ai-vision-icon.png"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "public/ai-vision-icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/ai-vision-icon.svg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/ai-vision-icon.svg"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/hands": "^0.4.1675469240",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.1.17",
    "@types/dompurify": "^3.0.5",
    "@vercel/speed-insights": "^1.3.1",
    "dompurify": "^3.3.1",
    "firebase": "^12.7.0",
    "lucide-react": "^0.556.0",
    "obs-websocket-js": "^5.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-redux": "^9.2.0",
    "recharts": "^3.5.1",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.17",
    "tmi.js": "^1.8.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "fast-check": "^3.22.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3",
    "web-vitals": "^5.1.0",
    "ws": "^8.18.3"
  }
}
