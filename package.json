{
  "name": "twitchvote-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "description": "Aplicación de encuestas en vivo para Twitch",
  "author": "TwitchVote Team",
  "build": {
    "appId": "com.twitchvote.app",
    "productName": "TwitchVote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/ai-vision-icon.png"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": ["dir"],
      "icon": "public/ai-vision-icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": ["dmg"],
      "icon": "public/ai-vision-icon.svg"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "public/ai-vision-icon.svg"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.5.1",
    "tailwindcss": "^4.1.17",
    "tmi.js": "^1.8.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "fast-check": "^3.22.0",
    "jsdom": "^27.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^2.1.0",
    "wait-on": "^9.0.3"
  }
}
