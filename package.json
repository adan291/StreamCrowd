{
  "name": "twitchvote-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:e2e",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "description": "Aplicación de encuestas en vivo para Twitch",
  "author": "TwitchVote Team",
  "build": {
    "appId": "com.twitchvote.app",
    "productName": "TwitchVote",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/ai-vision-icon.png"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "dir"
      ],
      "icon": "public/ai-vision-icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/ai-vision-icon.svg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/ai-vision-icon.svg"
    }
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/hands": "^0.4.1675469240",
    "@tailwindcss/vite": "^4.1.17",
    "firebase": "^12.7.0",
    "lucide-react": "^0.556.0",
    "obs-websocket-js": "^5.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.5.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.17",
    "tmi.js": "^1.8.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "fast-check": "^3.22.0",
    "jsdom": "^27.3.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.1",
    "typescript": "~5.8.2",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.0.15",
    "wait-on": "^9.0.3",
    "ws": "^8.18.3"
  }
}
