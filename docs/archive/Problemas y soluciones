    }
  }
```

- RT-005.4: Implementar retry logic:
```typescript
// hooks/useRetry.ts
  export const useRetry = (fn: () => Promise<any>, maxRetries = 3) => {
    const [retrying, setRetrying] = useState(false);

    const execute = async () => {
      setRetrying(true);
      let lastError;

      for (let i = 0; i < maxRetries; i++) {
        try {
          return await fn();
        } catch (error) {
          lastError = error;
          await new Promise(r => setTimeout(r, 1000 * (i + 1))); // exponential backoff
        }
      }

      throw lastError;
    };

    return { execute, retrying };
  };
```

