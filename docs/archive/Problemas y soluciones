### **DES-003: Error Handling y Resiliencia**

**Solución Propuesta:**
Implementar Error Boundaries, logging centralizado, y retry logic.

**Cambios Esperados:**

```typescript
// components/shared/ErrorBoundary.tsx
import React from 'react';
import { logService } from '../../../infrastructure/logging/LogService';

interface Props {
  children: React.ReactNode;
  feature?: string;
  onError?: (error: Error) => void;
}

interface State {
  hasError: boolean;
  error: Error | null;
  errorCount: number;
}

export class ErrorBoundary extends React.Component<Props, State> {
  constructor(props: Props) {
    super(props);
    this.state = { hasError: false, error: null, errorCount: 0 };
  }

  static getDerivedStateFromError(error: Error): State {
    return { hasError: true, error, errorCount: 1 };
  }

  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {
    // Log error
    logService.error({
      feature: this.props.feature,
      error: error.message,
      stack: error.stack,
      componentStack: errorInfo.componentStack,
      timestamp: new Date().toISOString(),
    });

    // Notificar app
    this.props.onError?.(error);
  }

  handleRetry = () => {
    this.setState({ hasError: false, error: null });
  };

  render() {
    if (this.state.hasError) {
      return (
        <div className="error-fallback">
          <h2>Error en {this.props.feature}</h2>
          <p>{this.state.error?.message}</p>
          <button onClick={this.handleRetry}>Reintentar</button>
          {this.state.errorCount > 2 && (
            <p className="text-gray-500">
              Si el error persiste, contacta a soporte
            </p>
          )}
        </div>
      );
    }

    return this.props.children;
  }
}

