// src/presentation/components/OverlayRouter.tsx
import { lazy, Suspense } from 'react';

// Lazy load cada overlay
const PollOverlay = lazy(() => import('./features/poll/PollOverlay'));
const SpinnerOverlay = lazy(() => import('./features/poll/SpinnerOverlay'));
const GiveawayOverlay = lazy(() => import('./features/giveaway/GiveawayOverlay'));
const JudgePanelOverlay = lazy(() => import('./features/judge/JudgePanelOverlay'));

interface Props {
  type: string;
  config?: any;
}

export const OverlayRouter: React.FC<Props> = ({ type, config }) => {
  const getOverlay = () => {
    switch (type) {
      case 'poll': return <PollOverlay {...config} />;
      case 'spinner': return <SpinnerOverlay {...config} />;
      case 'giveaway': return <GiveawayOverlay {...config} />;
      case 'judge': return <JudgePanelOverlay {...config} />;
      default: return null;
    }
  };

  return (
    <Suspense fallback={<LoadingOverlay />}>
      {getOverlay()}
    </Suspense>
  );
};

const LoadingOverlay = () => (
  <div className="flex items-center justify-center w-full h-full bg-black/50">
    <div className="animate-spin">⏳</div>
  </div>
);
