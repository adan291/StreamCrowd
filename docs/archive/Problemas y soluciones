// Estructura de cada slice:
// pollSlice.ts
import { createSlice, PayloadAction } from '@reduxjs/toolkit';

interface PollState {
  active: Poll | null;
  history: Poll[];
  isCreating: boolean;
  error: string | null;
}

const initialState: PollState = {
  active: null,
  history: [],
  isCreating: false,
  error: null,
};

const pollSlice = createSlice({
  name: 'poll',
  initialState,
  reducers: {
    createPoll: (state, action: PayloadAction<Poll>) => {
      state.active = action.payload;
    },
    addVote: (state, action: PayloadAction<{ optionId: string; count: number }>) => {
      if (state.active) {
        state.active.votes[action.payload.optionId] += action.payload.count;
      }
    },
    endPoll: (state) => {
      if (state.active) {
        state.history.push(state.active);
        state.active = null;
      }
    },
  },
});

export const { createPoll, addVote, endPoll } = pollSlice.actions;
export default pollSlice.reducer;
```


