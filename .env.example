# StreamCrowd Environment Variables

# Kiro AI Integration
VITE_KIRO_API_URL=https://your-kiro-api.vercel.app
VITE_KIRO_API_KEY=your-kiro-api-key

# Firebase Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Twitch API
VITE_TWITCH_CLIENT_ID=your-twitch-client-id
VITE_TWITCH_CLIENT_SECRET=your-twitch-client-secret
VITE_TWITCH_REDIRECT_URI=http://localhost:5173/auth/callback

# YouTube API
VITE_YOUTUBE_API_KEY=your-youtube-api-key
VITE_YOUTUBE_CLIENT_ID=your-youtube-client-id

# Kick API (if available)
VITE_KICK_API_URL=https://kick.com/api

# OBS WebSocket
VITE_OBS_WEBSOCKET_URL=ws://localhost:4455
VITE_OBS_WEBSOCKET_PASSWORD=your-obs-password

# Development
VITE_DEV_MODE=true
VITE_DEBUG_AI=false