# Copy to .env.local for local development (never commit .env.local).
# On Vercel set the same variables in Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Client (VITE_*): bundled into the public JavaScript. Only public identifiers
# here, never secrets.
# ---------------------------------------------------------------------------
VITE_TWITCH_CLIENT_ID=
VITE_YOUTUBE_CLIENT_ID=
VITE_KICK_CLIENT_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Server only (api/firebase-token.ts). SECRET: set them in Vercel, not here
# if this file is shared. From Firebase Console → Project settings → Service
# accounts → Generate new private key.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes, in quotes: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Twitch app whose tokens the endpoint accepts (defaults to VITE_TWITCH_CLIENT_ID)
TWITCH_CLIENT_ID=
# Optional: extra accepted client ids, comma-separated
TWITCH_ALLOWED_CLIENT_IDS=
