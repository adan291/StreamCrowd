{
  "rules": {
    // ------------------------------------------------------------------
    // IDENTITY
    // auth.uid          anonymous uid, or "twitch:<user_id>" after login
    // auth.token.twitchId  set ONLY by /api/firebase-token after Twitch
    //                      validates the user's token (custom token claim).
    // Anonymous users never have auth.token.twitchId, so every rule below
    // that compares it denies them.
    // ------------------------------------------------------------------

    // Overlay state shown on stream (polls, countdown, games...).
    // Public read: OBS browser sources read it without logging in, using
    // ?owner=<uid> in the overlay URL. Only the owner session writes.
    "overlays": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // Moderators of a channel, published by the broadcaster from Helix
    // ("Get Moderators"). Grants read access to the broadcaster token.
    "channel_moderators": {
      "$broadcasterId": {
        ".read": "auth != null && auth.token.twitchId == $broadcasterId",
        ".write": "auth != null && auth.token.twitchId == $broadcasterId",
        "$moderatorId": {
          ".validate": "newData.isBoolean() && $moderatorId.matches(/^[0-9]+$/)"
        }
      }
    },

    // Broadcaster Twitch token, so moderators can run broadcaster-only
    // actions (polls, predictions, raids). Owner writes/deletes; owner and
    // listed moderators read.
    "broadcaster_tokens": {
      "$broadcasterId": {
        ".read": "auth != null && auth.token.twitchId != null && (auth.token.twitchId == $broadcasterId || root.child('channel_moderators').child($broadcasterId).child(auth.token.twitchId).val() == true)",
        ".write": "auth != null && auth.token.twitchId == $broadcasterId",
        ".validate": "newData.hasChildren(['broadcasterId', 'broadcasterLogin', 'accessToken', 'storedAt']) && newData.child('broadcasterId').val() == $broadcasterId"
      }
    },

    // Tokens for other platforms (YouTube, Kick). Their ids cannot be
    // verified here, so each entry belongs to the verified Twitch account
    // that stored it (ownerTwitchId). Twitch entries must be the owner's own.
    "platform_broadcaster_tokens": {
      "$platform": {
        "$broadcasterId": {
          ".read": "auth != null && auth.token.twitchId != null && data.child('ownerTwitchId').exists() && (data.child('ownerTwitchId').val() == auth.token.twitchId || root.child('channel_moderators').child(data.child('ownerTwitchId').val()).child(auth.token.twitchId).val() == true)",
          ".write": "auth != null && auth.token.twitchId != null && ($platform != 'twitch' || $broadcasterId == auth.token.twitchId) && (!data.exists() || data.child('ownerTwitchId').val() == auth.token.twitchId || ($platform == 'twitch' && $broadcasterId == auth.token.twitchId))",
          ".validate": "newData.hasChildren(['platform', 'broadcasterId', 'accessToken', 'storedAt', 'ownerTwitchId']) && newData.child('ownerTwitchId').val() == auth.token.twitchId && newData.child('platform').val() == $platform"
        }
      }
    },

    // Per-user private data (reserved).
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // Public streamer pages: profile and giveaways. Anyone can read (the
    // viewer site); only the verified streamer writes.
    "streamers": {
      "$twitchId": {
        "profile": {
          ".read": true,
          ".write": "auth != null && auth.token.twitchId == $twitchId",
          ".validate": "newData.hasChildren(['twitchId', 'displayName', 'updatedAt']) && newData.child('twitchId').val() == $twitchId"
        },
        "sorteos": {
          ".read": true,
          "$sorteoId": {
            ".write": "auth != null && auth.token.twitchId == $twitchId",
            ".validate": "newData.hasChildren(['id', 'name', 'isActive', 'createdAt'])"
          }
        }
      }
    },

    // Default: deny everything else
    ".read": false,
    ".write": false
  }
}
