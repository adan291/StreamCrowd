{
  "rules": {
    "overlays": {
      "$uid": {
        "$overlayType": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['type', 'updatedAt'])"
        }
      }
    },
    
    "broadcaster_tokens": {
      "$broadcasterId": {
        ".read": "auth != null && auth.uid == $broadcasterId",
        ".write": "auth != null && auth.uid == $broadcasterId",
        ".validate": "newData.hasChildren(['broadcasterId', 'broadcasterLogin', 'encryptedToken', 'storedAt']) && newData.child('broadcasterId').val() == $broadcasterId"
      }
    },
    
    "platform_broadcaster_tokens": {
      "$platform": {
        "$broadcasterId": {
          ".read": "auth != null && auth.uid == $broadcasterId",
          ".write": "auth != null && auth.uid == $broadcasterId",
          ".validate": "newData.hasChildren(['platform', 'broadcasterId', 'encryptedToken', 'storedAt']) && newData.child('broadcasterId').val() == $broadcasterId && newData.child('platform').val() == $platform"
        }
      }
    },
    
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['displayName', 'email', 'createdAt'])"
      }
    },
    
    "streamers": {
      "$twitchId": {
        "profile": {
          ".read": true,
          ".write": "auth != null && auth.uid == $twitchId",
          ".validate": "newData.hasChildren(['displayName', 'updatedAt'])"
        },
        "sorteos": {
          ".read": true,
          "$sorteoId": {
            ".write": "auth != null && auth.uid == $twitchId",
            ".validate": "newData.hasChildren(['id', 'name', 'isActive', 'createdAt', 'ownerId']) && newData.child('ownerId').val() == $twitchId"
          }
        }
      }
    },
    
    "giveaways": {
      "$giveawayId": {
        ".read": "auth != null && data.child('ownerId').val() == auth.uid || data.child('public').val() == true",
        ".write": "auth != null && (!data.exists() && newData.child('ownerId').val() == auth.uid || data.child('ownerId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['title', 'ownerId', 'createdAt']) && newData.child('ownerId').isString() && newData.child('title').isString()"
      }
    },
    
    "polls": {
      "$pollId": {
        ".read": "auth != null && data.child('ownerId').val() == auth.uid || data.child('public').val() == true",
        ".write": "auth != null && (!data.exists() && newData.child('ownerId').val() == auth.uid || data.child('ownerId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['title', 'options', 'ownerId', 'createdAt']) && newData.child('ownerId').isString() && newData.child('title').isString()"
      }
    },
    
    "sessions": {
      "$sessionId": {
        ".read": "auth != null && data.child('userId').val() == auth.uid",
        ".write": "auth != null && (!data.exists() && newData.child('userId').val() == auth.uid || data.child('userId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['userId', 'overlayType', 'createdAt', 'expiresAt']) && newData.child('userId').isString() && newData.child('expiresAt').isNumber()"
      },
      ".indexOn": ["userId", "expiresAt"]
    },
    
    "overlay_sessions": {
      "$sessionId": {
        ".read": true,
        ".write": "auth != null && (!data.exists() && newData.child('ownerId').val() == auth.uid || data.child('ownerId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['ownerId', 'overlayType', 'overlayData', 'createdAt', 'expiresAt']) && newData.child('ownerId').isString() && newData.child('expiresAt').isNumber() && newData.child('expiresAt').val() > now"
      },
      ".indexOn": ["ownerId", "expiresAt"]
    },
    
    ".read": false,
    ".write": false
  }
}
