{
  "rules": {
    // Overlay sync - authenticated users write to their own path
    // Structure: /overlays/{uid}/{overlayType}
    "overlays": {
      "$uid": {
        // Read: anyone can read (needed for overlay viewers in OBS)
        ".read": true,
        // Write: only the authenticated owner can write to their own path
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    
    // Broadcaster tokens - only authenticated users can access
    // The linkedPlatformId stored client-side should match broadcasterId
    // SECURITY: Only the broadcaster or their moderators can access tokens
    "broadcaster_tokens": {
      "$broadcasterId": {
        // Allow read if authenticated and is the broadcaster or a moderator
        ".read": "auth != null && (auth.uid == $broadcasterId || root.child('broadcaster_tokens').child($broadcasterId).child('moderators').hasChild(auth.uid))",
        // Allow write only if authenticated and is the broadcaster
        ".write": "auth != null && (!data.exists() || data.child('broadcasterId').val() == $broadcasterId)",
        ".validate": "newData.hasChildren(['broadcasterId', 'broadcasterLogin', 'accessToken', 'storedAt'])"
      }
    },
    
    // Platform broadcaster tokens (multi-platform support)
    // SECURITY: Same restrictions as broadcaster_tokens
    "platform_broadcaster_tokens": {
      "$platform": {
        "$broadcasterId": {
          // Allow read if authenticated and is the broadcaster or a moderator
          ".read": "auth != null && (auth.uid == $broadcasterId || root.child('platform_broadcaster_tokens').child($platform).child($broadcasterId).child('moderators').hasChild(auth.uid))",
          // Allow write only if authenticated and is the broadcaster
          ".write": "auth != null && (!data.exists() || data.child('broadcasterId').val() == $broadcasterId)",
          ".validate": "newData.hasChildren(['platform', 'broadcasterId', 'accessToken', 'storedAt'])"
        }
      }
    },
    
    // User-specific data (future use)
    "users": {
      "$uid": {
        // Users can only read/write their own data
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    
    // Streamers data - profiles and giveaways
    // Structure: /streamers/{twitchId}/profile, /streamers/{twitchId}/sorteos/{sorteoId}
    "streamers": {
      "$twitchId": {
        // Profile: public read, write only by owner
        "profile": {
          ".read": true,
          ".write": "auth != null"
        },
        // Sorteos: public read, write only by authenticated users
        "sorteos": {
          ".read": true,
          "$sorteoId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['id', 'name', 'isActive', 'createdAt'])"
          }
        }
      }
    },
    
    // Default: deny all other access
    ".read": false,
    ".write": false
  }
}
